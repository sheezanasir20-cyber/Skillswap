# SkillSwap Environment Variables Example

# Server Configuration
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://skillswap:skillswap_secret@localhost:5432/skillswap_db?schema=public
POSTGRES_USER=skillswap
POSTGRES_PASSWORD=skillswap_secret
POSTGRES_DB=skillswap_db
POSTGRES_PORT=5432

# Security & Secrets
JWT_SECRET=skillswap_secure_jwt_secret_token_key_development_32chars!
SESSION_SECRET=skillswap_secure_session_secret_key_development_32chars!
COOKIE_SECRET=skillswap_cookie_secret_32_chars_development!

# Email Service (Mock in development, SMTP in staging/production)
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=noreply@skillswap.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Reminders & Background Worker
REMINDER_INTERVAL_MS=30000
LOG_LEVEL=info
