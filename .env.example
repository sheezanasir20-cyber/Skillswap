# ==============================================================================
# SkillSwap — Environment Configuration Template (.env.example)
# ==============================================================================
# Duplicate this file to .env and supply actual values for your deployment.
# Never commit the .env file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Domains & CORS
# ------------------------------------------------------------------------------
APP_ORIGIN=https://skillswap.example.com
CORS_ORIGIN=https://skillswap.example.com

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://skillswap_admin:your_secure_db_password@postgres:5432/skillswap_production?schema=public
POSTGRES_USER=skillswap_admin
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=skillswap_production
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. Cryptographic Authentication & Session Secrets (Minimum 32 characters)
# ------------------------------------------------------------------------------
JWT_SECRET=generate_a_random_64_character_hex_secret_key_for_jwt_tokens!
SESSION_SECRET=generate_a_random_64_character_hex_secret_key_for_user_session!
COOKIE_SECRET=generate_a_random_64_character_hex_secret_key_for_signed_cookies!

# ------------------------------------------------------------------------------
# 5. Email Service (SMTP / Transactional Gateway)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@skillswap.example.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_smtp_password_or_api_key

# ------------------------------------------------------------------------------
# 6. Background Workers & Rate Limiting
# ------------------------------------------------------------------------------
REMINDER_INTERVAL_MS=60000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 7. Frontend Vite Configuration
# ------------------------------------------------------------------------------
VITE_APP_NAME=SkillSwap
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/
